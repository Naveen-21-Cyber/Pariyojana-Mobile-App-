<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only system CAs — user-installed CAs are NOT trusted (C2 security fix).
                 This prevents MITM attacks using tools like Burp Suite or mitmproxy. -->
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <!-- Explicitly allow OpenRouter, Jina Reader, and Nvidia APIs with system certificates only -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">openrouter.ai</domain>
        <domain includeSubdomains="true">r.jina.ai</domain>
        <domain includeSubdomains="true">s.jina.ai</domain>
        <domain includeSubdomains="true">integrate.api.nvidia.com</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
