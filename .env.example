# Pariyojana — Environment Template
# Copy this file to .env and fill in any values you want to pre-configure.
# All keys below can also be set at runtime via Settings → API Keys & Endpoints
# and are stored securely in the Android Keystore via flutter_secure_storage.

# ─── AI / LLM ────────────────────────────────────────────────────────────────
# OpenRouter API key (https://openrouter.ai/keys)
# Format: sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Personal Access Token for GitHub API (project repo stats sync)
# Scopes needed: repo (read), user (read)
GITHUB_PAT=

# ─── Maps / Routing ──────────────────────────────────────────────────────────
# OpenRouteService key for interview route map (https://openrouteservice.org)
OPENROUTESERVICE_API_KEY=

# ─── Custom / Self-Hosted LLM (optional) ─────────────────────────────────────
# Base URL of a local Ollama or OpenAI-compatible endpoint
# Example: http://192.168.1.10:11434/v1
CUSTOM_LLM_BASE_URL=

# Custom model name to use with the above endpoint (e.g. llama3.2, mistral)
CUSTOM_LLM_MODEL=
